# dnsmasq-webmin configuration - restart the service after changes:
#   systemctl restart dnsmasq-webmin

# Bind address. 0.0.0.0 = all interfaces, 127.0.0.1 = local only.
# The app has no authentication - restrict access by firewall or put a
# reverse proxy with auth in front of it.
APP_HOST=0.0.0.0
APP_PORT=5000

# dnsmasq conf dir the generated files are written to
DNSMASQ_WEBMIN_CONF_DIR=/etc/dnsmasq.d
# document store (TinyDB); /var/lib/dnsmasq-webmin is managed by systemd
DNSMASQ_WEBMIN_DB_PATH=/var/lib/dnsmasq-webmin/db.json
# only files with this prefix are ever touched
DNSMASQ_WEBMIN_FILE_PREFIX=webmin-
# systemd unit restarted from the UI; empty disables the restart button
DNSMASQ_WEBMIN_SYSTEMD_UNIT=dnsmasq.service
