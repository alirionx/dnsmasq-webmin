#!/bin/sh
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl disable --now dnsmasq-webmin.service || true
fi

# byte-code was created by postinst, so dpkg does not know about it
find /opt/dnsmasq-webmin -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true

exit 0
